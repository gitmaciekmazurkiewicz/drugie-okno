<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Drugie okno"
        Width="600" Height="400"
        Background="#F0F4F8">
    <StackPanel VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Warsztat" FontSize="40" Foreground="DarkSlateBlue" HorizontalAlignment="Center" />
        <TextBlock Text="Drugie okno zbudowane z agentem" HorizontalAlignment="Center" />
        <Button Content="Kliknij mnie" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
